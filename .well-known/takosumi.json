{
  "apiVersion": "takosumi.com/v2.2",
  "kind": "Repository",
  "install": {
    "defaultModule": "deploy/opentofu/takoform",
    "modules": {
      "deploy/opentofu/takoform": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "ワークスペース名",
              "en": "Workspace name"
            },
            "helper": {
              "ja": "Takosの論理リソース名に使います。実際のクラウドは選択したTakoform hostが決めます。",
              "en": "Used for Takos logical resource names. The selected Takoform host chooses the concrete cloud."
            }
          },
          {
            "name": "public_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は実行先が公開URLを割り当てます。",
              "en": "The destination allocates a public URL when omitted."
            }
          },
          {
            "name": "agent_image",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Agent実行イメージ",
              "en": "Agent image"
            },
            "helper": {
              "ja": "実行先から取得できるdigest固定OCI imageを指定します。",
              "en": "A digest-pinned OCI image reachable by the destination."
            },
            "placeholder": "ghcr.io/tako0614/takos-agent@sha256:...",
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosリリース",
              "en": "Takos release"
            },
            "helper": {
              "ja": "公開済みの完全なTakosリリースタグを指定します。",
              "en": "Select an exact published Takos release tag."
            },
            "placeholder": "v0.12.4",
            "advanced": true
          },
          {
            "name": "worker_artifact_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Worker artifact URL",
              "en": "Worker artifact URL"
            },
            "helper": {
              "ja": "指定したTakosリリースのimmutable Worker archive URLです。",
              "en": "The immutable Worker archive URL for the selected Takos release."
            },
            "placeholder": "https://github.com/tako0614/takos/releases/download/v0.12.4/takos-worker-release.tar.gz",
            "advanced": true
          },
          {
            "name": "worker_artifact_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Worker artifact SHA-256",
              "en": "Worker artifact SHA-256"
            },
            "helper": {
              "ja": "公開されたarchiveと一致するSHA-256を指定します。",
              "en": "Provide the SHA-256 published for that archive."
            },
            "placeholder": "sha256:...",
            "advanced": true
          },
          {
            "name": "takosumi_accounts_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts URL",
              "en": "Takosumi Accounts URL"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_redirect_uri",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "OIDCリダイレクトURL",
              "en": "OIDC redirect URL"
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "public_url"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/auth/oidc/callback",
            "scopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "capsules:read",
              "capsules:write"
            ],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          },
          {
            "kind": "interface.consume",
            "key": "ai",
            "interface": {
              "type": "takosumi.ai.gateway",
              "version": "1"
            },
            "permissions": [
              "ai.chat"
            ],
            "delivery": {
              "type": "oauth2"
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos",
                  "icon": "/logo.png"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "ui.open"
                ],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          }
        ]
      },
      "deploy/opentofu/cloudflare": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "ワークスペース名",
              "en": "Workspace name"
            },
            "helper": {
              "ja": "Takosのサービスとクラウドリソースに使う名前です。",
              "en": "The name used for the Takos service and its cloud resources."
            }
          },
          {
            "name": "public_subdomain",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "公開サブドメイン",
              "en": "Public subdomain"
            },
            "advanced": true
          },
          {
            "name": "public_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は利用可能な公開URLを使います。",
              "en": "Uses an available public URL when omitted."
            },
            "placeholder": "https://takos.example.com"
          },
          {
            "name": "environment",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "実行環境",
              "en": "Environment"
            },
            "advanced": true
          },
          {
            "name": "cloudflare",
            "source": {
              "kind": "user"
            },
            "type": "json",
            "required": true,
            "label": {
              "ja": "Cloudflare デプロイ設定",
              "en": "Cloudflare deployment settings"
            },
            "helper": {
              "ja": "Cloudflare の account_id と、必要なら workers_subdomain を JSON で指定します。認証情報は Provider Connection から別に渡されます。",
              "en": "Provide the Cloudflare account_id and optional workers_subdomain as JSON. Credentials are delivered separately through a Provider Connection."
            },
            "placeholder": "{\"account_id\":\"...\",\"workers_subdomain\":\"...\"}",
            "advanced": true
          },
          {
            "name": "takosumi_accounts_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts URL",
              "en": "Takosumi Accounts URL"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_redirect_uri",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "OIDCリダイレクトURL",
              "en": "OIDC redirect URL"
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "public_url",
                "subdomain": "public_subdomain"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/auth/oidc/callback",
            "scopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "capsules:read",
              "capsules:write"
            ],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          },
          {
            "kind": "interface.consume",
            "key": "ai",
            "interface": {
              "type": "takosumi.ai.gateway",
              "version": "1"
            },
            "permissions": [
              "ai.chat"
            ],
            "delivery": {
              "type": "oauth2"
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos",
                  "icon": "/logo.png"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "ui.open"
                ],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
