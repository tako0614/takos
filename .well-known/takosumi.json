{
  "apiVersion": "takosumi.com/v2",
  "kind": "Repository",
  "install": {
    "modules": {
      "deploy/opentofu": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "ワークスペース名",
              "en": "Workspace name"
            },
            "helper": {
              "ja": "Takosのサービスとクラウドリソースに使う名前です。",
              "en": "The name used for the Takos service and its cloud resources."
            }
          },
          {
            "name": "public_subdomain",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "公開サブドメイン",
              "en": "Public subdomain"
            },
            "advanced": true
          },
          {
            "name": "public_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は利用可能な公開URLを使います。",
              "en": "Uses an available public URL when omitted."
            },
            "placeholder": "https://takos.example.com"
          },
          {
            "name": "environment",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "実行環境",
              "en": "Environment"
            },
            "advanced": true
          },
          {
            "name": "cloudflare",
            "source": {
              "kind": "user"
            },
            "type": "json",
            "required": true,
            "label": {
              "ja": "Cloudflare デプロイ設定",
              "en": "Cloudflare deployment settings"
            },
            "helper": {
              "ja": "Cloudflare の account_id と、必要なら workers_subdomain を JSON で指定します。認証情報は Provider Connection から別に渡されます。",
              "en": "Provide the Cloudflare account_id and optional workers_subdomain as JSON. Credentials are delivered separately through a Provider Connection."
            },
            "placeholder": "{\"account_id\":\"...\",\"workers_subdomain\":\"...\"}",
            "advanced": true
          },
          {
            "name": "takosumi_accounts_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts URL",
              "en": "Takosumi Accounts URL"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_redirect_uri",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "OIDCリダイレクトURL",
              "en": "OIDC redirect URL"
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "public_url",
                "subdomain": "public_subdomain"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/auth/oidc/callback",
            "scopes": ["openid", "profile", "email"],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos",
                  "icon": "/logo.png"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": ["ui.open"],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
