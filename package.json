s/__tests__/apps-interface-launcher-proof.test.ts src/worker/server/routes/__tests__/git-smart-http.test.ts src/worker/server/routes/__tests__/logout-contract.test.ts src/worker/server/routes/__tests__/memory-write-validation.test.ts src/worker/server/routes/__tests__/message-create-validation.test.ts src/worker/server/routes/__tests__/run-create-validation.test.ts src/worker/server/routes/__tests__/skill-write-validation.test.ts src/worker/server/routes/__tests__/space-member-validation.test.ts src/worker/server/routes/__tests__/space-write-validation.test.ts src/worker/server/routes/__tests__/setup-contract.test.ts src/worker/server/routes/__tests__/storage-upload-boundary.test.ts src/worker/server/routes/__tests__/user-settings-validation.test.ts src/worker/server/routes/__tests__/thread-create-validation.test.ts src/worker/server/routes/__tests__/thread-search-query.test.ts src/worker/server/routes/index/graph.test.ts src/worker/server/routes/agent-tasks/__tests__/enrichment.test.ts src/worker/server/routes/agent-tasks/__tests__/routes.test.ts src/worker/server/routes/capsules_test.ts src/worker/server/routes/me/__tests__/privacy.test.ts src/worker/server/routes/public-share/__tests__/routes.test.ts src/worker/server/routes/pull-requests/__tests__/diff.test.ts src/worker/server/routes/runs/__tests__/observation.test.ts src/worker/server/routes/spaces/__tests__/storage-management.test.ts web/src/__tests__/views/apps/inflight-installs.test.ts web/src/__tests__/views/apps/registered-apps.test.ts",
