{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@takosjp/takosumi-accounts-contract": [
        "../../takosumi/accounts/contract/src/mod.ts"
      ],
      "takos-api-contract/rpc-types": ["../src/contracts/public/rpc-types.ts"],
      "takos-api-contract/chat-message": [
        "../src/contracts/public/chat-message.ts"
      ],
      "takos-api-contract/chat-thread": [
        "../src/contracts/public/chat-thread.ts"
      ],
      "takos-api-contract/chat-history": [
        "../src/contracts/public/chat-history.ts"
      ],
      "takos-api-contract/thread-share": [
        "../src/contracts/public/thread-share.ts"
      ],
      "takos-api-contract/thread-export": [
        "../src/contracts/public/thread-export.ts"
      ],
      "takos-api-contract/mcp-connections": [
        "../src/contracts/public/mcp-connections.ts"
      ],
      "takos-api-contract/shared/types": [
        "../src/contracts/public/shared/types/index.ts"
      ]
    }
  },
  "include": ["src/**/*", "*.ts"],
  "exclude": ["node_modules"]
}
