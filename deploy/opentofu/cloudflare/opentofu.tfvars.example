# Copy to opentofu.tfvars and source secret values from the operator-local
# secret store. Do not commit the rendered opentofu.tfvars file.
# CLOUDFLARE_API_TOKEN is supplied by the Takosumi ProviderConnection at Run time.
# Use the canonical lowercase HTTPS origin without a trailing slash or path.
public_url = "https://takos.example.com"
cloudflare = {
  account_id = "replace-with-cloudflare-account-id"
}

# The app-owned Cloudflare provider-gap bridge is disabled by default. Leave
# this as "off" for ordinary installs. Use environment = "staging" with
# "staging" only for disposable smoke inputs, or environment = "production"
# with "disposable-production" for a one-shot production-equivalent E2E after
# review. The latter additionally requires the exact acknowledgement:
# cloudflare_provider_gap_bridge_acknowledgement = "DISPOSABLE_PRODUCTION_ONE_SHOT"
cloudflare_provider_gap_bridge_mode = "off"

# Takos runtime secrets are operator-owned. They never pass through this file,
# OpenTofu state, or an Output. Generate them with `bun run generate:keys` and
# load ENCRYPTION_KEY, TAKOS_AGENT_START_TOKEN, TAKOS_INTERNAL_API_SECRET,
# PLATFORM_PRIVATE_KEY, and PLATFORM_PUBLIC_KEY with `wrangler secret put`.
#
# This stays true for every apply after the first. A Worker Version's binding
# list is complete, so false publishes a version with no ENCRYPTION_KEY and
# everything encrypted under it stays unreadable.
runtime_secrets_provisioned = true

# The very first apply, before any value exists, has nothing to inherit. That
# one apply sets runtime_secrets_provisioned = false and states it here:
#
#   runtime_secrets_provisioned   = false
#   first_install_acknowledgement = "FIRST_INSTALL_WITHOUT_RUNTIME_SECRETS"
#
# Then load the five values and put both back to the settings above.
first_install_acknowledgement = ""

# The Cloudflare provider cannot create a Vectorize index, so this module never
# creates one on the ordinary provider path. Leave this false and the Worker
# runs in the declared `vectorSearch: disabled` mode: semantic search endpoints
# answer 501 CAPABILITY_UNAVAILABLE and text search keeps working. Create the
# index named by the `cloudflare_vectorize_index_name` output yourself, then set
# this to true so the Worker Version binds it.
vector_index_provisioned = false
